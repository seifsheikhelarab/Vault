DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Storage provider: 'local' (default) or 's3'
STORAGE_PROVIDER=local
# Base URL used for local upload URLs (defaults to BETTER_AUTH_URL or http://localhost:3001)
APP_URL=http://localhost:3001
# Directory for local uploads relative to server root (defaults to ./uploads)
LOCAL_UPLOAD_DIR=./uploads

# S3-compatible storage configuration (only needed when STORAGE_PROVIDER=s3)
S3_REGION=us-east-1
S3_BUCKET=my-receipts-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Optional: custom S3-compatible endpoint (e.g. Cloudflare R2, MinIO, DigitalOcean Spaces)
S3_ENDPOINT=
# Optional: public base URL for uploaded files (defaults to S3_ENDPOINT or AWS virtual-hosted URL)
S3_PUBLIC_URL=
