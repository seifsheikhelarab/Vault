{
    "name": "server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "test": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "format": "prettier . --write"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1098.0",
        "@better-auth/drizzle-adapter": "^1.6.25",
        "@hono/node-server": "^2.0.12",
        "@hono/zod-validator": "^0.9.0",
        "better-auth": "^1.6.25",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.32",
        "postgres": "^3.4.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.8.0",
        "globals": "^17.8.0",
        "prettier": "3.9.6",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
