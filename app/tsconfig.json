{
    "compilerOptions": {
        "rootDir": "./src",
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "paths": {
            "@expense/shared": ["../packages/shared/src"]
        },
        "baseUrl": "."
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
